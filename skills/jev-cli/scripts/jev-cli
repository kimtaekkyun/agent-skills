#!/usr/bin/env python3
"""jev-cli: ask TypeSafe's Jev Noul, Choice, and Score questions.

Standard library only. No install step. Needs TYPESAFE_API_KEY.

  jev-cli                                                interactive menu
  jev-cli noul "Is this about billing?" -s "I was charged twice."
  jev-cli ask -s "$STATE" --noul billing="Is this about billing?" -o json
  jev-cli ask --request request.json                         # one API request
  cat tickets.txt | jev-cli noul "Is this about billing?" --lines -o jsonl

System One requests and responses are JSON. Use JSONL only to stream independent
one-state results from --lines. Exit codes: 0 ok, 1 input/config, 2 API/network,
3 partial --lines failure. Stdout carries data; diagnostics go to stderr.
"""

import argparse
import json
import math
import os
import socket
import sys
import time
import urllib.error
import urllib.request

API_URL = os.environ.get("TYPESAFE_BASE_URL", "https://api.typesafe.ai") + "/v1/systemone"
DEFAULT_MODEL = os.environ.get("TYPESAFE_DEFAULT_MODEL", "jev-latest")
TIMEOUT_SECONDS = 60
RETRIES = 3

EXIT_OK, EXIT_USAGE, EXIT_API, EXIT_PARTIAL = 0, 1, 2, 3


def paint(text, *codes):
    """Wrap text in ANSI codes only when writing to a color terminal."""
    if not (sys.stdout.isatty() and "NO_COLOR" not in os.environ):
        return text
    return f"\033[{';'.join(codes)}m{text}\033[0m"


BOLD, DIM, RED, GREEN, CYAN, YELLOW = "1", "2", "31", "32", "36", "33"


class Fail(Exception):
    """User-facing error with an exit code."""

    def __init__(self, message, code=EXIT_USAGE):
        super().__init__(message)
        self.code = code


class UsageParser(argparse.ArgumentParser):
    """argparse exits 2 on usage errors; jev-cli reserves 2 for API failures."""

    def error(self, message):
        self.print_usage(sys.stderr)
        sys.stderr.write(f"jev-cli: {message}\n")
        sys.exit(EXIT_USAGE)


# ---------- request building ----------


def make_question(kind, instructions, criteria=None):
    q = {"type": kind, "instructions": instructions}
    if criteria is not None:
        q["criteria"] = criteria
    return q


def choice_criteria(items):
    """['calm=Neutral', 'angry'] -> {'calm': 'Neutral', 'angry': None}"""
    criteria = {}
    for item in items:
        name, _, description = item.partition("=")
        name = name.strip()
        if not name:
            raise Fail(f"empty criterion name in {item!r}")
        if name in criteria:
            raise Fail(f"duplicate criterion name {name!r}")
        criteria[name] = description.strip() or None
    if len(criteria) < 2:
        raise Fail("choice needs at least two -c criteria")
    return criteria


def score_levels(items):
    levels = [x.strip() for x in items if x.strip()]
    if len(levels) < 2:
        raise Fail("score needs at least two -c levels, lowest first")
    return levels


# ---------- API ----------


def api_key():
    key = os.environ.get("TYPESAFE_API_KEY", "").strip()
    if not key:
        raise Fail(
            "TYPESAFE_API_KEY is not set.\n"
            "  Set it first:  export TYPESAFE_API_KEY=<your key>\n"
            "  Create a key:  https://console.typesafe.ai/keys"
        )
    return key


def retry_after(error):
    value = error.headers.get("Retry-After") if error.headers else None
    try:
        return min(float(value), 30.0)
    except (TypeError, ValueError):
        return None


def call_api(payload, key):
    """Send one official System One JSON request and return its raw JSON response."""
    body = json.dumps(payload).encode("utf-8")
    for attempt in range(RETRIES):
        req = urllib.request.Request(
            API_URL,
            data=body,
            headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
            method="POST",
        )
        try:
            with urllib.request.urlopen(req, timeout=TIMEOUT_SECONDS) as resp:
                raw = resp.read()
            break
        except urllib.error.HTTPError as e:
            detail = e.read().decode("utf-8", "replace")[:300]
            if not (e.code == 429 or e.code >= 500):
                raise Fail(f"API error {e.code}: {detail}", EXIT_API)
            error = Fail(f"API error {e.code}: {detail}", EXIT_API)
            wait = retry_after(e)
        except (urllib.error.URLError, socket.timeout, TimeoutError) as e:
            error = Fail(f"network error: {getattr(e, 'reason', e)}", EXIT_API)
            wait = None
        if attempt == RETRIES - 1:
            raise error
        time.sleep(wait if wait is not None else 2**attempt)

    try:
        response = json.loads(raw)
    except (ValueError, TypeError):
        raise Fail("API returned invalid JSON", EXIT_API)
    if not isinstance(response, dict) or not isinstance(response.get("answers"), dict):
        raise Fail("API returned an unexpected response shape", EXIT_API)
    return response


def call_questions(state, questions, model, key):
    return call_api({"model": model or DEFAULT_MODEL, "state": state, "questions": questions}, key)


def validate_response(response, questions):
    answers = response.get("answers")
    if not isinstance(answers, dict):
        raise Fail("API response has no answers object", EXIT_API)
    for qid, question in questions.items():
        answer = answers.get(qid)
        kind = question.get("type")
        if not isinstance(answer, dict) or answer.get("type") != kind:
            raise Fail(f"API response is missing the expected answer for {qid!r}", EXIT_API)
        if kind == "noul":
            valid = isinstance(answer.get("noul"), (int, float))
        elif kind == "choice":
            valid = (isinstance(answer.get("choice"), str)
                     and isinstance(answer.get("probabilities"), dict)
                     and isinstance(answer.get("confidence"), (int, float)))
        elif kind == "score":
            valid = (isinstance(answer.get("score"), (int, float))
                     and isinstance(answer.get("probabilities"), dict)
                     and isinstance(answer.get("confidence"), (int, float))
                     and isinstance(answer.get("legend"), dict))
        else:
            valid = False
        if not valid:
            raise Fail(f"API answer {qid!r} has an unexpected shape", EXIT_API)
    return response


# ---------- results ----------


def to_record(index, answer, question):
    """One stable record per item. Fields not used by the type are null."""
    kind = answer["type"]
    if kind == "noul":
        return {"index": index, "ok": True, "kind": "noul", "value": answer["noul"],
                "label": None, "confidence": None, "probabilities": None}
    if kind == "choice":
        return {"index": index, "ok": True, "kind": "choice", "value": answer["choice"],
                "label": None, "confidence": answer["confidence"],
                "probabilities": answer["probabilities"]}
    if kind == "score":
        score = answer["score"]
        criteria = question["criteria"]
        probabilities = answer.get("probabilities") or {}
        if probabilities:
            level = max(range(len(criteria)), key=lambda i: probabilities.get(str(i), 0.0))
        else:
            level = min(max(math.floor(score + 0.5), 0), len(criteria) - 1)
        legend = answer.get("legend") or {}
        label = legend.get(str(level), legend.get(level, criteria[level]))
        return {"index": index, "ok": True, "kind": "score", "value": score,
                "label": label, "confidence": answer["confidence"],
                "probabilities": probabilities or None}
    raise Fail(f"unexpected answer type {kind!r}", EXIT_API)


def error_record(index, error):
    return {"index": index, "ok": False, "error": str(error)}


def format_text(record):
    if not record["ok"]:
        return paint(f"error: {record['error']}", RED)
    kind = record["kind"]
    if kind == "noul":
        return paint("noul", BOLD) + "  " + paint(f"{record['value']:.2f}", GREEN, BOLD) \
            + paint("  probability that the statement is true", DIM)
    if kind == "choice":
        return paint("choice", BOLD) + "  " + paint(record["value"], GREEN, BOLD) \
            + paint(f"  confidence {record['confidence']:.2f}", DIM)
    return paint("score", BOLD) + "  " + paint(f"{record['value']:.2f}", GREEN, BOLD) \
        + "  " + paint(record["label"], GREEN) + paint(f"  confidence {record['confidence']:.2f}", DIM)


def print_text_details(record, question):
    """Show Choice probabilities by criterion and Score probabilities by level."""
    probabilities = record.get("probabilities")
    if not (record.get("ok") and probabilities):
        return
    print(paint("  probabilities", DIM))
    if record["kind"] == "score":
        criteria = question["criteria"]
        pairs = [(criteria[int(index)], probability)
                 for index, probability in probabilities.items()
                 if index.isdigit() and 0 <= int(index) < len(criteria)]
    else:
        pairs = list(probabilities.items())
    for name, probability in sorted(pairs, key=lambda kv: -kv[1]):
        print(f"    {name:<24} {probability:.2f}")


def run_items(items, question, model, key, output, batch):
    """Run one question for each state. Each item is a separate API request."""
    if batch and output == "json":
        raise Fail("--lines produces one response per state; use -o jsonl")
    failures = 0
    for index, text in items:
        try:
            questions = {"answer": question}
            response = validate_response(call_questions(text, questions, model, key), questions)
            answer = response["answers"]["answer"]
            record = to_record(index, answer, question)
        except Fail as e:
            if not batch:
                raise
            failures += 1
            record = error_record(index, e)
        except (KeyError, TypeError, ValueError, IndexError, AttributeError):
            error = Fail("API returned an unexpected answer shape", EXIT_API)
            if not batch:
                raise error
            failures += 1
            record = error_record(index, error)
        if output == "json":
            print(json.dumps(response, ensure_ascii=False))
        elif output == "jsonl":
            print(json.dumps(record, ensure_ascii=False))
        elif batch:
            print(f"{index}\t{format_text(record)}")
        else:
            print(format_text(record))
            print_text_details(record, question)
    if failures == 0:
        return EXIT_OK
    return EXIT_API if failures == len(items) else EXIT_PARTIAL


# ---------- command line ----------


def read_items(args):
    if args.state is not None:
        text = args.state
    elif args.file is not None:
        try:
            text = sys.stdin.read() if args.file == "-" else open(args.file, encoding="utf-8").read()
        except OSError as e:
            raise Fail(f"cannot read {args.file}: {e}")
    elif not sys.stdin.isatty():
        text = sys.stdin.read()
    else:
        raise Fail("give text with -s TEXT, -f FILE, or pipe it on stdin")

    if args.lines:
        items = [(i, line) for i, line in enumerate(text.splitlines(), start=1) if line.strip()]
    else:
        items = [(1, text)] if text.strip() else []
    if not items:
        raise Fail("input is empty")
    return items


def cmd_question(args, kind):
    key = api_key()  # check configuration before reading any input
    if kind == "noul":
        question = make_question("noul", args.instructions)
    elif kind == "choice":
        question = make_question("choice", args.instructions, choice_criteria(args.criterion))
    else:
        question = make_question("score", args.instructions, score_levels(args.criterion))
    items = read_items(args)
    return run_items(items, question, args.model, key, args.output, batch=args.lines)


def parse_binding(item, label):
    name, sep, value = item.partition("=")
    if not sep or not name.strip() or not value.strip():
        raise Fail(f"{label} must use ID=VALUE syntax: {item!r}")
    return name.strip(), value.strip()


def build_ask_payload(args):
    """Build one API request from a JSON request file or typed flags."""
    if args.request is not None:
        if args.state is not None or args.noul or args.choice or args.choice_criterion or args.score or args.score_criterion:
            raise Fail("--request cannot be combined with --state or question flags")
        try:
            if args.request == "-":
                request = json.load(sys.stdin)
            else:
                with open(args.request, encoding="utf-8") as f:
                    request = json.load(f)
        except (OSError, UnicodeError, json.JSONDecodeError) as e:
            raise Fail(f"cannot read System One JSON request: {e}")
        if not isinstance(request, dict):
            raise Fail("request JSON must be one object")
        if "assets" in request:
            raise Fail("JSON assets and image requests are not supported by this CLI; use the TypeSafe SDK/API")
        if "state" not in request or not isinstance(request.get("questions"), dict) or not request["questions"]:
            raise Fail('request JSON must contain "state" and a non-empty "questions" object')
        for qid, question in request["questions"].items():
            if not isinstance(question, dict) or question.get("type") not in ("noul", "choice", "score"):
                raise Fail(f"question {qid!r}: only Noul, Choice, and Score are supported")
            if "instructions" not in question:
                raise Fail(f"question {qid!r} has no instructions")
        request = dict(request)
        request["model"] = args.model or request.get("model") or DEFAULT_MODEL
        return request

    if args.state is not None:
        state = args.state
    elif not sys.stdin.isatty():
        state = sys.stdin.read()
    else:
        raise Fail("give state with -s/--state, or pipe it on stdin")
    if not state.strip():
        raise Fail("state is empty")

    questions = {}
    kinds = {}
    for kind, definitions in (("noul", args.noul), ("choice", args.choice), ("score", args.score)):
        for item in definitions:
            qid, instructions = parse_binding(item, f"--{kind}")
            if qid in questions:
                raise Fail(f"duplicate question ID {qid!r}")
            questions[qid] = make_question(kind, instructions)
            kinds[qid] = kind

    choice_criteria_by_id = {}
    for item in args.choice_criterion:
        qid, criterion = parse_binding(item, "--choice-criterion")
        if kinds.get(qid) != "choice":
            raise Fail(f"--choice-criterion references unknown Choice question ID {qid!r}")
        choice_criteria_by_id.setdefault(qid, []).append(criterion)
    for qid, items in choice_criteria_by_id.items():
        questions[qid]["criteria"] = choice_criteria(items)
    for qid, kind in kinds.items():
        if kind == "choice" and qid not in choice_criteria_by_id:
            raise Fail(f"Choice question {qid!r} needs at least two --choice-criterion values")

    score_criteria_by_id = {}
    for item in args.score_criterion:
        qid, level = parse_binding(item, "--score-criterion")
        if kinds.get(qid) != "score":
            raise Fail(f"--score-criterion references unknown Score question ID {qid!r}")
        score_criteria_by_id.setdefault(qid, []).append(level)
    for qid, levels in score_criteria_by_id.items():
        questions[qid]["criteria"] = score_levels(levels)
    for qid, kind in kinds.items():
        if kind == "score" and qid not in score_criteria_by_id:
            raise Fail(f"Score question {qid!r} needs at least two --score-criterion values")

    if not questions:
        raise Fail("add at least one --noul, --choice, or --score question")
    return {"model": args.model or DEFAULT_MODEL, "state": state, "questions": questions}


def print_system_one_text(response):
    print(f"model: {response.get('model', 'unknown')}")
    answers = response["answers"]
    for qid, answer in answers.items():
        kind = answer.get("type")
        if kind == "noul":
            print(f"{qid} [Noul]: {answer['noul']:.2f} (probability of yes)")
        elif kind == "choice":
            print(f"{qid} [Choice]: {answer['choice']} (confidence {answer['confidence']:.2f})")
            for name, probability in sorted(answer["probabilities"].items(), key=lambda pair: -pair[1]):
                print(f"  {name}: {probability:.2f}")
        elif kind == "score":
            probabilities = answer.get("probabilities", {})
            legend = answer.get("legend", {})
            best = max(probabilities, key=probabilities.get) if probabilities else None
            label = legend.get(str(best), legend.get(best, "")) if best is not None else ""
            print(f"{qid} [Score]: {answer['score']:.2f} (most likely level: {label}; confidence {answer['confidence']:.2f})")
            for index, probability in sorted(probabilities.items(), key=lambda pair: -pair[1]):
                level = legend.get(str(index), legend.get(index, str(index)))
                print(f"  {level}: {probability:.2f}")
        else:
            raise Fail(f"API returned unsupported answer type for question {qid!r}", EXIT_API)
    usage = response.get("usage")
    if isinstance(usage, dict):
        print(f"usage: {usage.get('input_tokens', '?')} input, {usage.get('output_tokens', '?')} output tokens")


def cmd_ask(args):
    key = api_key()
    request = build_ask_payload(args)
    response = validate_response(call_api(request, key), request["questions"])
    if args.output == "json":
        print(json.dumps(response, indent=2, ensure_ascii=False))
    else:
        print_system_one_text(response)
    return EXIT_OK


def add_io_flags(p):
    src = p.add_argument_group("state (one of these, or pipe on stdin)")
    group = src.add_mutually_exclusive_group()
    group.add_argument("-s", "--state", help="state: the text Jev judges")
    group.add_argument("-f", "--file", help="read text from FILE ('-' for stdin)")
    p.add_argument("--lines", action="store_true",
                   help="treat each non-empty line as one item; one result per line")
    p.add_argument("-m", "--model", help=f"model name (default: {DEFAULT_MODEL})")
    p.add_argument("-o", "--output", choices=["text", "json", "jsonl"], default="text",
                   help="text, raw System One JSON, or normalized JSONL for --lines")


def build_parser():
    parser = UsageParser(
        prog="jev-cli",
        description="Ask Jev Noul, Choice, and Score questions. "
        "Use 'ask' to send several questions in one request. "
        "Run with no arguments in a terminal for the interactive menu.",
        epilog="environment: TYPESAFE_API_KEY (required), TYPESAFE_DEFAULT_MODEL (optional)\n"
        "exit codes: 0 ok, 1 usage/input/config error, 2 API or network failure, "
        "3 some --lines items failed",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command", metavar="{ask,noul,choice,score}")

    p = sub.add_parser("ask", help="send several Noul, Choice, and Score questions in one request")
    p.add_argument("--request", metavar="FILE", help="read one System One JSON request from FILE ('-' for stdin)")
    p.add_argument("-s", "--state", help="state for questions built from flags; or pipe state on stdin")
    p.add_argument("--noul", action="append", default=[], metavar="ID=INSTRUCTIONS",
                   help="add a Noul question; repeat for each")
    p.add_argument("--choice", action="append", default=[], metavar="ID=INSTRUCTIONS",
                   help="add a Choice question; repeat for each")
    p.add_argument("--choice-criterion", action="append", default=[], metavar="ID=NAME[=DESCRIPTION]",
                   help="add a Choice criterion for question ID; repeat for each")
    p.add_argument("--score", action="append", default=[], metavar="ID=INSTRUCTIONS",
                   help="add a Score question; repeat for each")
    p.add_argument("--score-criterion", action="append", default=[], metavar="ID=LEVEL",
                   help="add a Score level, lowest first; repeat for each")
    p.add_argument("-m", "--model", help=f"model name (default: {DEFAULT_MODEL})")
    p.add_argument("-o", "--output", choices=["json", "text"], default="json",
                   help="raw System One JSON (default) or readable text")
    p.set_defaults(run=cmd_ask)

    p = sub.add_parser("noul", help="a statement; returns the probability it is true")
    p.add_argument("instructions", help="the statement, e.g. 'Is this about billing?'")
    add_io_flags(p)
    p.set_defaults(run=lambda a: cmd_question(a, "noul"))

    p = sub.add_parser("choice", help="pick one of named criteria")
    p.add_argument("instructions", help="e.g. 'What is the tone?'")
    p.add_argument("-c", "--criterion", action="append", default=[], metavar="NAME[=DESC]",
                   help="a criterion; repeat for each")
    add_io_flags(p)
    p.set_defaults(run=lambda a: cmd_question(a, "choice"))

    p = sub.add_parser("score", help="rate on ordered levels")
    p.add_argument("instructions", help="e.g. 'How urgent is this?'")
    p.add_argument("-c", "--criterion", action="append", default=[], metavar="LEVEL",
                   help="a level, lowest first; repeat for each")
    add_io_flags(p)
    p.set_defaults(run=lambda a: cmd_question(a, "score"))
    return parser


# ---------- interactive ----------

KINDS = {
    "1": ("noul", "Noul", "a statement; Jev returns the probability that it is true"),
    "2": ("choice", "Choice", "pick one of your criteria; Jev returns the probabilities"),
    "3": ("score", "Score", "rate on ordered levels; Jev returns one level"),
}


def ask_input(prompt):
    try:
        return input(prompt).strip()
    except (EOFError, KeyboardInterrupt):
        print()
        raise SystemExit(EXIT_OK)


def show_welcome():
    print()
    print(paint("jev-cli", BOLD, CYAN) + paint("  Ask Jev typed questions about a state.", DIM))
    print(paint("         Add one or more questions; Jev answers them in one request.", DIM))


def show_state(state):
    preview = state if len(state) <= 60 else state[:57] + "..."
    print()
    print(f"  {paint('state', BOLD)}  {preview}")
    print(paint(f"         {len(state)} characters", DIM))


def show_question_menu():
    print()
    print(paint("  Add question to this request", BOLD))
    for key, (_, name, desc) in KINDS.items():
        print(f"    {paint(key, CYAN)}  {paint(name.ljust(8), BOLD)}{paint(desc, DIM)}")
    print(f"    {paint('t', CYAN)}  change state")
    print(f"    {paint('q', CYAN)}  quit")


def read_state_until_valid():
    while True:
        text = ask_input(paint("state", BOLD) + paint(" (the text Jev will judge)", DIM) + "\n> ")
        if text:
            return text
        print(paint("  state is empty. Type or paste the text to judge.", RED))


def split_semicolon(raw):
    return [x.strip() for x in raw.split(";") if x.strip()]


def collect_interactive_question(kind, name, qid):
    print()
    example = {
        "noul": "Is this about billing?",
        "choice": "What is the tone?",
        "score": "How urgent is this?",
    }[kind]
    instructions = ask_input(
        paint(f"{name} instructions", BOLD)
        + paint(f" (the question, e.g. {example})", DIM)
        + "\n> "
    )
    if not instructions:
        raise Fail("instructions is empty")

    criteria = None
    if kind == "choice":
        raw = ask_input(
            paint("criteria", BOLD)
            + paint(" (your options, name=description, separated by ';')", DIM)
            + "\n  e.g. calm=Neutral or polite; angry=Upset or hostile\n> "
        )
        criteria = choice_criteria(split_semicolon(raw))
        question = make_question("choice", instructions, criteria)
    elif kind == "score":
        raw = ask_input(
            paint("criteria", BOLD)
            + paint(" (levels from lowest to highest, separated by ';')", DIM)
            + "\n  e.g. can wait; this week; today\n> "
        )
        criteria = score_levels(split_semicolon(raw))
        question = make_question("score", instructions, criteria)
    else:
        question = make_question("noul", instructions)

    return qid, question


def interactive_batch():
    questions = {}
    counters = {"noul": 0, "choice": 0, "score": 0}
    while True:
        show_question_menu()
        choice = ask_input(paint("Add a question [1/2/3, q to quit]> ", BOLD)).lower()
        if choice == "q":
            return None
        if choice == "t":
            return "change_state"
        if choice not in KINDS:
            print(paint("  choose 1 (Noul), 2 (Choice), 3 (Score), or q", DIM))
            continue
        kind, name, _ = KINDS[choice]
        counters[kind] += 1
        qid = f"{kind}_{counters[kind]}"
        try:
            qid, question = collect_interactive_question(kind, name, qid)
        except Fail as e:
            print(paint(f"  error: {e}", RED))
            counters[kind] -= 1
            continue
        questions[qid] = question
        print(paint(f"  queued {name} ({len(questions)} question(s))", GREEN))
        while True:
            more = ask_input("Add another question to this same request? [y/N]> ").lower()
            if more in ("y", "yes"):
                break
            if more in ("", "n", "no"):
                return questions
            if more in ("q", "quit"):
                return None
            print("  enter y to add one, n or Enter to send, or q to quit")


def print_interactive_answers(response):
    print()
    for qid, answer in response["answers"].items():
        kind = answer["type"]
        if kind == "noul":
            print(f"{paint(qid, BOLD)}  {answer['noul']:.2f}  (probability of yes)")
        elif kind == "choice":
            print(f"{paint(qid, BOLD)}  {answer['choice']}  (confidence {answer['confidence']:.2f})")
            for name, probability in sorted(answer["probabilities"].items(), key=lambda pair: -pair[1]):
                print(f"    {name}: {probability:.2f}")
        elif kind == "score":
            probs = answer["probabilities"]
            legend = answer["legend"]
            best = max(probs, key=probs.get)
            label = legend.get(str(best), legend.get(best, ""))
            print(f"{paint(qid, BOLD)}  {answer['score']:.2f}  -> {label}  (confidence {answer['confidence']:.2f})")
            for index, probability in sorted(probs.items(), key=lambda pair: -pair[1]):
                level = legend.get(str(index), legend.get(index, str(index)))
                print(f"    {level}: {probability:.2f}")


def interactive():
    key = api_key()
    try:
        import readline  # noqa: F401  (arrow keys and history, when available)
    except ImportError:
        pass

    show_welcome()
    state = read_state_until_valid()
    show_state(state)
    while True:
        questions = interactive_batch()
        if questions is None:
            return EXIT_OK
        if questions == "change_state":
            state = read_state_until_valid()
            show_state(state)
            continue
        try:
            response = validate_response(call_questions(state, questions, None, key), questions)
            print_interactive_answers(response)
        except Fail as e:
            print(paint(f"  error: {e}", RED))
        print()
        while True:
            action = ask_input("Next: [Enter] ask more about this state · [t] change state · [q] quit\njev-cli> ").lower()
            if action in ("", "a", "again"):
                break
            if action == "t":
                state = read_state_until_valid()
                show_state(state)
                break
            if action == "q":
                return EXIT_OK
            print("  press Enter, t, or q")


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if not argv:
        if not sys.stdin.isatty():
            UsageParser(prog="jev-cli").print_usage(sys.stderr)
            sys.stderr.write("jev-cli: no command given; run 'jev-cli --help'\n")
            return EXIT_USAGE
        try:
            return interactive()
        except Fail as e:
            print(f"jev-cli: {e}", file=sys.stderr)
            return e.code

    args = build_parser().parse_args(argv)
    if args.command is None:
        build_parser().print_help()
        return EXIT_USAGE
    try:
        return args.run(args)
    except Fail as e:
        print(f"jev-cli: {e}", file=sys.stderr)
        return e.code
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
